<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF6F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌷 Question 1/5"
                android:textColor="#D4847A"
                android:textSize="11sp"
                android:letterSpacing="0.1"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20%"
                android:textColor="#C4A09A"
                android:textSize="11sp"/>

        </LinearLayout>

        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:progress="20"
            android:progressTint="#D4847A"
            android:progressBackgroundTint="#F2D9D0"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Which brand owns this iconic logo?"
            android:textSize="18sp"
            android:textColor="#8B4A46"
            android:fontFamily="serif"
            android:textStyle="italic"
            android:layout_marginBottom="20dp"
            android:lineSpacingMultiplier="1.4"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/logo_lv"
            android:scaleType="fitCenter"
            android:background="@drawable/card_white"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/rg"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gucci"
                android:textColor="#8B5E5A"
                android:textSize="14sp"
                android:background="@drawable/radio_option"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:button="@null"
                android:drawableEnd="@null"/>

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prada"
                android:textColor="#8B5E5A"
                android:textSize="14sp"
                android:background="@drawable/radio_option"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:button="@null"/>

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Louis Vuitton"
                android:textColor="#8B5E5A"
                android:textSize="14sp"
                android:background="@drawable/radio_option"
                android:padding="14dp"
                android:layout_marginBottom="8dp"
                android:button="@null"/>

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Burberry"
                android:textColor="#8B5E5A"
                android:textSize="14sp"
                android:background="@drawable/radio_option"
                android:padding="14dp"
                android:button="@null"/>

        </RadioGroup>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/bNext"
            android:text="Next →"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_pink"
            android:padding="14dp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>

</ScrollView>