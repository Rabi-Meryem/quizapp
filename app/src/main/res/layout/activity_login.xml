<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF6F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌸"
            android:textSize="40sp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back, girl"
            android:textSize="26sp"
            android:textColor="#C4706A"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="200dp"
            android:layout_height="1dp"
            android:background="#E8B4A8"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR LUXURY QUIZ"
            android:textSize="10sp"
            android:textColor="#D4847A"
            android:letterSpacing="0.15"
            android:layout_marginBottom="30dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etLogin"
            android:hint="✉️  Email address"
            android:textColor="#8B5E5A"
            android:textColorHint="#C4A09A"
            android:background="@drawable/input_rounded"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:inputType="textEmailAddress"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etPassword"
            android:hint="🔒  Password"
            android:textColor="#8B5E5A"
            android:textColorHint="#C4A09A"
            android:background="@drawable/input_rounded"
            android:padding="14dp"
            android:layout_marginBottom="20dp"
            android:inputType="textPassword"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/bLogin"
            android:text="Sign In ✨"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_pink"
            android:padding="14dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="or"
            android:textColor="#C4A09A"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"/>

        <com.google.android.gms.common.SignInButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/bGoogleLogin"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvRegister"
            android:text="New here? Register"
            android:textColor="#D4847A"
            android:textSize="13sp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>

</ScrollView>