<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF6F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎀"
            android:textSize="40sp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join the club, girl"
            android:textSize="26sp"
            android:textColor="#C4706A"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:layout_marginBottom="8dp"/>

        <View
            android:layout_width="200dp"
            android:layout_height="1dp"
            android:background="#E8B4A8"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CREATE YOUR ACCOUNT"
            android:textSize="10sp"
            android:textColor="#D4847A"
            android:letterSpacing="0.15"
            android:layout_marginBottom="30dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etName"
            android:hint="🌸  Your name"
            android:textColor="#8B5E5A"
            android:textColorHint="#C4A09A"
            android:background="@drawable/input_rounded"
            android:padding="14dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etMail"
            android:hint="✉️  Email address"
            android:textColor="#8B5E5A"
            android:textColorHint="#C4A09A"
            android:background="@drawable/input_rounded"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:inputType="textEmailAddress"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etPassword"
            android:hint="🔒  Password"
            android:textColor="#8B5E5A"
            android:textColorHint="#C4A09A"
            android:background="@drawable/input_rounded"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:inputType="textPassword"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/etPassword1"
            android:hint="🔒  Confirm password"
            android:textColor="#8B5E5A"
            android:textColorHint="#C4A09A"
            android:background="@drawable/input_rounded"
            android:padding="14dp"
            android:layout_marginBottom="24dp"
            android:inputType="textPassword"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/bRegister"
            android:text="Register ✨"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_pink"
            android:padding="14dp"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>

</ScrollView>